PORT=3000
# On Render, set this to a file under the service's persistent disk mount path (for example /var/data/claricare.db).
DATABASE_PATH=./data/claricare.db
CORS_ORIGIN=https://claricarebotanica.com,https://www.claricarebotanica.com,https://calicarebotanica.netlify.app,http://localhost:5173
# Used in referrer invitation links; defaults to the first CORS_ORIGIN.
FRONTEND_URL=https://claricarebotanica.com
JWT_SECRET=change_this_secret
# Optional owner login. When set, these credentials are promoted to admin at login.
ADMIN_NAME=ClariCare Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# SMTP credentials used when replying to contact form conversations.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
# Optional. Defaults to SMTP_USER.
SMTP_FROM=ClariCare Support <your-gmail-address@gmail.com>
# Optional Resend API delivery for invitations; when set, this takes priority over SMTP.
RESEND_API_KEY=
# Must use a sender address on a domain verified with Resend.
RESEND_FROM=ClariCare <invitations@claricarebotanica.com>
# Set temporarily for first-owner setup, then remove after creating the first admin.
ADMIN_SETUP_KEY=generate-a-long-random-one-time-key
